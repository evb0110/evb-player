{
  "name": "evb-player",
  "productName": "EVB Player",
  "version": "0.2.7",
  "description": "An offline player for folders of video and audio files, for macOS, Windows, and Linux.",
  "author": {
    "name": "Eugene Barsky",
    "email": "34789976+evb0110@users.noreply.github.com"
  },
  "homepage": "https://evb-player.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/evb0110/evb-player.git"
  },
  "main": "dist-electron/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "pnpm run build:desktop:renderer && pnpm run build:electron",
    "build:web": "node scripts/build-web.mjs",
    "build:desktop:renderer": "nuxi generate && node scripts/patch-static-output.mjs && node scripts/check-icons.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "pnpm run build && electron .",
    "package:mac": "pnpm run build && electron-builder --mac --publish never",
    "typecheck": "nuxi typecheck && tsc -p tsconfig.electron.json --noEmit",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/circle-flags": "^1.2.11",
    "@iconify-json/lucide": "^1.2.93",
    "@nuxt/ui": "4.11.1",
    "@types/node": "^24.0.0",
    "@vueuse/core": "^14.4.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "es-toolkit": "^1.52.0",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vue": "3.5.42",
    "vue-i18n": "^11.4.12",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.33.0"
}
